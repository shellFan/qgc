# QGC Staging Environment Variables
# 复制此文件为 qgc-staging.env 并填入真实值
# 禁止将真实Secret提交到Git

# ========================================
# 微信公众号配置 (OAuth + JS-SDK)
# ========================================
QGC_WECHAT_MP_APPID=
QGC_WECHAT_MP_APPSECRET=

# 微信OAuth回调基础URL (HTTPS)
QGC_WECHAT_CALLBACK_BASE_URL=https://<DOMAIN>

# 允许的回调域名(逗号分隔)
QGC_WECHAT_ALLOWED_DOMAINS=https://<DOMAIN>

# Mock模式: true=模拟, false=真实微信
QGC_WECHAT_MOCK_ENABLED=false

# ========================================
# 微信支付配置 (NATIVE/JSAPI)
# ========================================
# 支付模式: MOCK=模拟, NATIVE=扫码支付, JSAPI=公众号支付
QGC_PAY_MODE=NATIVE
# 商户模式: DIRECT(普通商户)
QGC_PAY_MERCHANT_MODE=DIRECT
# Native二维码过期时间(分钟)
QGC_PAY_NATIVE_EXPIRE_MINUTES=5

# JSAPI模式需要AppId(公众号), Native模式不需要
QGC_PAY_APPID=
QGC_PAY_MCH_ID=
QGC_PAY_MCH_KEY=
QGC_PAY_API_V3_KEY=
QGC_PAY_PRIVATE_KEY_PATH=/opt/qgc/certs/apiclient_key.pem
QGC_PAY_CERT_PATH=/opt/qgc/certs/apiclient_cert.pem
QGC_PAY_CERTIFICATE_SERIAL_NO=
QGC_PAY_NOTIFY_URL=https://<DOMAIN>/api/payment/notify/pay
QGC_PAY_REFUND_NOTIFY_URL=https://<DOMAIN>/api/payment/notify/refund

# 兼容旧配置(优先使用QGC_PAY_MODE)
QGC_PAY_MOCK_ENABLED=false

# ========================================
# 数据库
# ========================================
QGC_DB_URL=jdbc:mysql://localhost:3306/qgc?useSSL=false&characterEncoding=utf8mb4
QGC_DB_USERNAME=
QGC_DB_PASSWORD=

# ========================================
# Redis
# ========================================
QGC_REDIS_HOST=localhost
QGC_REDIS_PORT=6379
QGC_REDIS_PASSWORD=

# ========================================
# MinIO
# ========================================
QGC_MINIO_ENDPOINT=http://localhost:9000
QGC_MINIO_ACCESS_KEY=
QGC_MINIO_SECRET_KEY=
QGC_MINIO_BUCKET=qgc

# ========================================
# JWT
# ========================================
QGC_JWT_SECRET=

# ========================================
# 服务配置
# ========================================
QGC_SERVER_PORT=8080