# QGC 穷鬼筹 环境配置示例
# 复制此文件为 .env 并修改配置值

# MySQL
MYSQL_ROOT_PASSWORD=qiongguichou_root_2024
MYSQL_DATABASE=qiongguichou
MYSQL_USER=qiongguichou
MYSQL_PASSWORD=qiongguichou_pass_2024

# Redis
